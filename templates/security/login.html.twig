{% extends 'base.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block body %}
    <div class="mx-auto flex max-w-md flex-col px-4 py-20">
        <h1 class="text-2xl font-bold tracking-tight">Sign in</h1>
        <p class="mt-1 text-sm text-slate-500">Administration of the NeoPHP website.</p>

        {% if error %}
            <p class="mt-6 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700 ring-1 ring-red-200">{{ error }}</p>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}" class="mt-6 space-y-4">
            <div>
                <label for="username" class="block text-sm font-medium">Username</label>
                <input type="text" id="username" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus
                       class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-brand-500 focus:ring-2 focus:ring-brand-100 focus:outline-none">
            </div>

            <div>
                <label for="password" class="block text-sm font-medium">Password</label>
                <input type="password" id="password" name="_password" autocomplete="current-password" required
                       class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:border-brand-500 focus:ring-2 focus:ring-brand-100 focus:outline-none">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="w-full rounded-lg bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-brand-700">Sign in</button>
        </form>
    </div>
{% endblock %}