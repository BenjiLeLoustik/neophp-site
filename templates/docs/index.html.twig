{% extends 'base.html.twig' %}

{% block title %}Documentation{% endblock %}
{% block description %}Every NeoPHP documentation: components, packages and processes.{% endblock %}

{% set groups = {
    components: 'The building blocks of the framework: HTTP, routing, container, views, forms...',
    packages: 'Optional features plugged into the kernel: ORM, security, translation, Markdown...',
    process: 'Tools running around your application: the console and the installer.',
} %}

{% block body %}
    <section class="border-b border-slate-200 bg-slate-50">
        <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <p class="text-sm font-semibold text-brand-600">Documentation · {{ version }}</p>
                    <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">Everything NeoPHP can do</h1>
                    <p class="mt-3 max-w-2xl text-slate-600">Start with the guide, then dive into the documentation of
                        each feature.</p>
                </div>

                <div class="flex items-center gap-3">
                    <label for="doc-version" class="text-sm text-slate-500">Version</label>
                    <select id="doc-version" class="rounded-md border border-slate-300 bg-white px-2 py-1.5 text-sm"
                            onchange="window.location = this.value">
                        {% for item in versions %}
                            <option value="{{ path('docs_catalog', {version: item}) }}" {{ item == version ? 'selected' }}>{{ item }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div class="relative mt-8 max-w-2xl">
                <svg class="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-slate-400"
                     viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd"
                          d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.45 4.39l3.08 3.08a.75.75 0 1 1-1.06 1.06l-3.08-3.08A7 7 0 0 1 2 9Z"
                          clip-rule="evenodd"/>
                </svg>
                <input type="search" id="doc-search" placeholder="Search a feature, a topic, an option..."
                       autocomplete="off"
                       class="w-full rounded-xl border border-slate-300 bg-white py-3.5 pr-16 pl-12 text-base shadow-sm focus:border-brand-500 focus:ring-4 focus:ring-brand-100 focus:outline-none">
                <kbd class="pointer-events-none absolute top-1/2 right-4 hidden -translate-y-1/2 rounded border border-slate-300 px-1.5 py-0.5 font-mono text-xs text-slate-400 sm:block">/</kbd>
            </div>
            <p id="doc-search-count" class="mt-3 h-5 text-sm text-slate-500"></p>
        </div>
    </section>

    <div class="mx-auto max-w-7xl space-y-14 px-4 py-12 sm:px-6 lg:px-8">
        <a href="{{ path('docs_guide', {version: version}) }}" data-guide
           class="group flex flex-col gap-2 rounded-2xl bg-brand-600 p-8 text-white shadow-sm transition hover:bg-brand-700 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h2 class="text-2xl font-bold">Getting started</h2>
                <p class="mt-1 max-w-2xl text-brand-100">{{ guide ?? 'Create a NeoPHP application in a few minutes.' }}</p>
            </div>
            <span class="text-sm font-semibold whitespace-nowrap">Read the guide <span
                        class="inline-block transition group-hover:translate-x-1">&rarr;</span></span>
        </a>

        {% for group, items in catalog %}
            <section id="{{ group }}" data-group>
                <div class="mb-6 flex items-baseline justify-between gap-4 border-b border-slate-200 pb-3">
                    <div>
                        <h2 class="text-2xl font-bold capitalize">{{ group }}</h2>
                        <p class="mt-1 text-sm text-slate-500">{{ groups[group] ?? '' }}</p>
                    </div>
                    <span class="text-sm text-slate-400" data-group-count>{{ items|length }}</span>
                </div>

                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    {% for item in items %}
                        {% set url = path('docs_feature', {version: version, group: group, slug: item.slug}) %}
                        <div data-card
                             data-name="{{ item.name|lower }}"
                             data-text="{{ (item.description ?? '')|lower }}"
                             data-topics="{{ item.topics|json_encode|e('html_attr') }}"
                             data-url="{{ url }}"
                             class="group relative rounded-xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-brand-500 hover:shadow-md">
                            <h3 class="font-semibold group-hover:text-brand-600">
                                <a href="{{ url }}" class="after:absolute after:inset-0">{{ item.name }}</a>
                            </h3>
                            <p class="mt-2 line-clamp-3 text-sm text-slate-600">{{ item.description ?? '' }}</p>
                            <ul class="relative z-10 mt-3 hidden space-y-1 border-t border-slate-100 pt-3 text-sm"
                                data-matches></ul>
                        </div>
                    {% endfor %}
                </div>
            </section>
        {% endfor %}

        <div id="doc-search-empty"
             class="hidden rounded-2xl border border-dashed border-slate-300 px-6 py-16 text-center">
            <p class="text-lg font-semibold">No documentation found</p>
            <p class="mt-1 text-sm text-slate-500">Try another word, or <a
                        href="{{ path('docs_guide', {version: version}) }}" class="text-brand-600 hover:underline">read
                    the guide</a>.</p>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        (() => {
            const input = document.getElementById('doc-search');
            const count = document.getElementById('doc-search-count');
            const empty = document.getElementById('doc-search-empty');
            const guide = document.querySelector('[data-guide]');
            const groups = [...document.querySelectorAll('[data-group]')];
            const normalize = (text) => text.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            const escape = (text) => text.replace(/[&<>"']/g, (c) => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            }[c]));

            const cards = [...document.querySelectorAll('[data-card]')].map((element) => ({
                element,
                name: normalize(element.dataset.name),
                text: normalize(element.dataset.text),
                topics: JSON.parse(element.dataset.topics).map((topic) => ({...topic, search: normalize(topic.text)})),
                url: element.dataset.url,
                matches: element.querySelector('[data-matches]'),
            }));

            const search = () => {
                const terms = normalize(input.value.trim()).split(/\s+/).filter(Boolean);
                let total = 0;

                for (const card of cards) {
                    const haystack = [card.name, card.text, ...card.topics.map((topic) => topic.search)].join(' ');
                    const visible = terms.every((term) => haystack.includes(term));
                    const topics = terms.length && visible
                        ? card.topics.filter((topic) => terms.some((term) => topic.search.includes(term))).slice(0, 3)
                        : [];

                    card.element.classList.toggle('hidden', !visible);
                    card.matches.classList.toggle('hidden', topics.length === 0);
                    card.matches.innerHTML = topics.map((topic) =>
                        `<li><a href="${card.url}#${topic.id}" class="flex items-center gap-1.5 text-slate-500 hover:text-brand-600"><span class="text-brand-500">#</span>${escape(topic.text)}</a></li>`
                    ).join('');
                    total += visible ? 1 : 0;
                }

                for (const group of groups) {
                    const visible = group.querySelectorAll('[data-card]:not(.hidden)').length;
                    group.classList.toggle('hidden', visible === 0);
                    group.querySelector('[data-group-count]').textContent = visible;
                }

                guide.classList.toggle('hidden', terms.length > 0);
                empty.classList.toggle('hidden', total > 0);
                count.textContent = terms.length ? `${total} result${total > 1 ? 's' : ''}` : '';

                const url = new URL(window.location);
                terms.length ? url.searchParams.set('q', input.value.trim()) : url.searchParams.delete('q');
                history.replaceState(null, '', url);
            };

            input.addEventListener('input', search);
            input.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') {
                    input.value = '';
                    search();
                }
            });
            document.addEventListener('keydown', (event) => {
                if (event.key === '/' && document.activeElement !== input) {
                    event.preventDefault();
                    input.focus();
                }
            });

            input.value = new URLSearchParams(window.location.search).get('q') ?? '';
            search();
        })();
    </script>
{% endblock %}