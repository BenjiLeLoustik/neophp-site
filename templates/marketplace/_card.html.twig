{% import '_partials/icons.html.twig' as ui %}
{% set url = path('marketplace_show', {type: extension.folder, slug: extension.slug}) %}
<div data-card
     data-type="{{ extension.type }}"
     data-search="{{ [extension.id, extension.name, extension.author, extension.description, extension.tags|join(' ')]|join(' ')|lower }}"
     class="group relative flex flex-col rounded-xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-brand-500 hover:shadow-md">
    <div class="flex items-start gap-4">
        {% include 'marketplace/_icon.html.twig' with {extension: extension, size: 'size-12'} %}
        <div class="min-w-0 flex-1">
            <h3 class="truncate font-semibold group-hover:text-brand-600">
                <a href="{{ url }}" class="after:absolute after:inset-0">{{ extension.name }}</a>
            </h3>
            <p class="truncate text-sm text-slate-500">{{ extension.author }}</p>
        </div>
    </div>
    <p class="mt-3 line-clamp-2 flex-1 text-sm text-slate-600">{{ extension.description }}</p>
    <div class="mt-4 flex items-center gap-3 text-xs text-slate-500">
        <span class="rounded-full px-2 py-0.5 font-medium {{ extension.type == 'theme' ? 'bg-violet-50 text-violet-700' : 'bg-brand-50 text-brand-700' }}">{{ extension.type|capitalize }}</span>
        <span class="font-mono">v{{ extension.latest.version }}</span>
        <span class="ml-auto inline-flex items-center gap-1">{{ ui.icon('download', 'size-3.5') }} {{ downloads[extension.id] ?? 0 }}</span>
    </div>
</div>
