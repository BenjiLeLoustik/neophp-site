{% extends 'base.html.twig' %}

{% block title %}Analytics{% endblock %}

{% macro table(title, rows, columns, empty) %}
    <section class="min-w-0 rounded-xl border border-slate-200 bg-white">
        <h2 class="border-b border-slate-200 px-4 py-3 font-semibold sm:px-5">{{ title }}</h2>
        {% if rows is empty %}
            <p class="px-4 py-6 text-sm text-slate-400 sm:px-5">{{ empty }}</p>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full min-w-[20rem] table-fixed text-sm">
                    <thead class="text-left text-xs text-slate-400 uppercase">
                    <tr>
                        {% for key, label in columns %}
                            <th class="px-4 py-2 font-medium sm:px-5 {{ loop.first ? 'w-1/2' : 'text-right' }}">{{ label }}</th>
                        {% endfor %}
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                    {% for row in rows %}
                        <tr class="hover:bg-slate-50">
                            {% for key, label in columns %}
                                {% if loop.first %}
                                    <td class="truncate px-4 py-2 font-mono text-xs text-slate-700 sm:px-5" title="{{ row[key] }}">{{ row[key] }}</td>
                                {% else %}
                                    <td class="px-4 py-2 text-right tabular-nums sm:px-5">{{ row[key]|number_format(0, ',', ' ') }}</td>
                                {% endif %}
                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
{% endmacro %}

{% block body %}
    <div class="mx-auto max-w-7xl space-y-6 px-4 py-8 sm:space-y-8 sm:px-6 sm:py-10 lg:px-8">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">Analytics</h1>
                    <p class="mt-1 text-sm text-slate-500">Anonymous page views of the last {{ days }} days (UTC).</p>
                </div>
                <a href="{{ path('app_logout') }}" class="shrink-0 pt-1 text-sm text-slate-500 hover:text-brand-600 md:hidden">Log out</a>
            </div>
            <div class="flex items-center gap-3">
                <nav class="grid flex-1 grid-cols-3 rounded-lg border border-slate-200 bg-white p-1 text-center text-sm md:inline-grid md:flex-none">
                    {% for period in periods %}
                        <a href="{{ path('analytics', {days: period}) }}"
                           class="rounded-md px-3 py-1.5 {{ period == days ? 'bg-brand-600 font-medium text-white' : 'text-slate-600 hover:text-brand-600' }}">{{ period }}<span class="hidden sm:inline"> days</span><span class="sm:hidden">d</span></a>
                    {% endfor %}
                </nav>
                <a href="{{ path('app_logout') }}" class="hidden text-sm text-slate-500 hover:text-brand-600 md:inline">Log out</a>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4">
            {% for item in [
                {label: 'Page views', value: summary.views|number_format(0, ',', ' ')},
                {label: 'Unique visitors', value: summary.visitors|number_format(0, ',', ' ')},
                {label: 'Average response', value: summary.avg_ms ~ ' ms'},
            ] %}
                <div class="rounded-xl border border-slate-200 bg-white p-4 sm:p-5 {{ loop.last ? 'col-span-2 sm:col-span-1' : '' }}">
                    <p class="text-xs text-slate-500 sm:text-sm">{{ item.label }}</p>
                    <p class="mt-1 text-2xl font-bold tabular-nums sm:mt-2 sm:text-3xl">{{ item.value }}</p>
                </div>
            {% endfor %}
        </div>

        <section class="rounded-xl border border-slate-200 bg-white p-4 sm:p-5">
            <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
                <h2 class="font-semibold">Views per day</h2>
                <div class="flex items-center gap-4 text-xs text-slate-500">
                    <span class="flex items-center gap-1.5"><span class="size-2.5 rounded-sm bg-brand-600"></span>Views</span>
                    <span class="flex items-center gap-1.5"><span class="size-2.5 rounded-sm bg-brand-100"></span>Visitors</span>
                </div>
            </div>
            <div class="flex h-36 items-end {{ days > 30 ? 'gap-0' : 'gap-px sm:gap-0.5' }} sm:h-48">
                {% for day, stats in perDay %}
                    <div class="relative flex h-full min-w-0 flex-1 flex-col justify-end" title="{{ day|date('d/m') }}: {{ stats.views }} views, {{ stats.visitors }} visitors">
                        <div class="relative w-full rounded-t-sm bg-brand-600" style="height: {{ (stats.views / maxViews * 100)|round(1) }}%">
                            <div class="absolute inset-x-0 bottom-0 rounded-t-sm bg-brand-100/60" style="height: {{ stats.views > 0 ? (stats.visitors / stats.views * 100)|round(1) : 0 }}%"></div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="mt-2 flex justify-between text-xs text-slate-400">
                <span>{{ perDay|keys|first|date('d/m') }}</span>
                <span>{{ perDay|keys|last|date('d/m') }}</span>
            </div>
        </section>

        <div class="grid gap-4 sm:gap-6 lg:grid-cols-2">
            {{ _self.table('Top pages', topPages, {path: 'Page', views: 'Views', visitors: 'Visitors', avg_ms: 'ms'}, 'No page view yet.') }}
            {{ _self.table('Top documentation', topDocs, {path: 'Documentation', views: 'Views', visitors: 'Visitors', avg_ms: 'ms'}, 'No documentation read yet.') }}
            {{ _self.table('Referrers', referrers, {referrer: 'Domain', views: 'Views'}, 'No external referrer yet.') }}
            {{ _self.table('Not found (404)', notFound, {path: 'Page', views: 'Views'}, 'No broken link. 🎉') }}
        </div>
    </div>
{% endblock %}