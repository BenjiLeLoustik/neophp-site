{% extends 'base.html.twig' %}

{% block title %}NeoIDE, the IDE of NeoPHP{% endblock %}
{% block description %}Download NeoIDE, the desktop IDE made for NeoPHP, and extend it with plugins and themes.{% endblock %}

{% block body %}
    {% import '_partials/icons.html.twig' as ui %}

    <section class="relative overflow-hidden border-b border-slate-200">
        <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,var(--color-brand-100),transparent_60%)]"></div>
        <div class="mx-auto max-w-7xl px-4 py-16 text-center sm:px-6 sm:py-24 lg:px-8">
            <span class="mx-auto grid size-16 place-items-center rounded-2xl bg-brand-600 text-white shadow-lg">{{ ui.icon('code', 'size-8') }}</span>
            <h1 class="mx-auto mt-8 max-w-3xl text-4xl font-extrabold tracking-tight text-balance sm:text-6xl">
                <span class="bg-gradient-to-r from-brand-600 to-violet-500 bg-clip-text text-transparent">NeoIDE</span>, the IDE made for NeoPHP
            </h1>
            <p class="mx-auto mt-6 max-w-2xl text-base text-slate-600 sm:text-lg">
                A desktop IDE that knows your NeoPHP application, extended by plugins and themes from the marketplace.
            </p>

            {% if release %}
                <div class="mt-10 flex flex-col items-center gap-3">
                    <a href="{{ path('neoide_download') }}"
                       class="inline-flex items-center gap-3 rounded-xl bg-brand-600 px-7 py-4 text-base font-semibold text-white shadow-lg hover:bg-brand-700">
                        {{ ui.icon('download', 'size-5') }} Download for Windows
                    </a>
                    <p class="text-sm text-slate-500">
                        Version <span class="font-mono">{{ release.version }}</span> · {{ release.file }}
                        {% if release.date %} · {{ release.date }}{% endif %}
                        {% if release.size %} · {{ (release.size / 1048576)|number_format(1) }} MB{% endif %}
                        · <a href="{{ releasesUrl }}" target="_blank" rel="noopener" class="font-medium text-brand-600 hover:underline">All releases</a>
                    </p>
                    {% if release.sha256 %}
                        <p class="max-w-full font-mono text-xs break-all text-slate-400" title="SHA-256">SHA-256 {{ release.sha256 }}</p>
                    {% endif %}
                </div>
            {% else %}
                <p class="mx-auto mt-10 max-w-md rounded-xl border border-dashed border-slate-300 px-6 py-5 text-sm text-slate-500">NeoIDE is not available for download yet. Come back soon!</p>
            {% endif %}
        </div>
    </section>

    <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <section class="grid gap-6 sm:grid-cols-2">
            {% for item in [
                {icon: 'puzzle', title: pluginCount ~ ' plugin' ~ (pluginCount > 1 ? 's'), text: 'New tools, languages and integrations, installed from NeoIDE in one click.', url: path('marketplace_index', {type: 'plugins'})},
                {icon: 'palette', title: themeCount ~ ' theme' ~ (themeCount > 1 ? 's'), text: 'Pick the colors you code with.', url: path('marketplace_index', {type: 'themes'})},
            ] %}
                <a href="{{ item.url }}" class="group rounded-xl border border-slate-200 p-6 transition hover:border-brand-500 hover:shadow-md">
                    <span class="grid size-10 place-items-center rounded-lg bg-brand-50 text-brand-600">{{ ui.icon(item.icon, 'size-5') }}</span>
                    <h2 class="mt-4 font-semibold group-hover:text-brand-600">{{ item.title }}</h2>
                    <p class="mt-1 text-sm text-slate-600">{{ item.text }}</p>
                </a>
            {% endfor %}
        </section>

        {% if notes %}
            <section class="mt-16">
                <h2 class="text-2xl font-bold">What's new in {{ release.version }}</h2>
                <div class="prose prose-slate mt-4 max-w-none prose-a:text-brand-600">{{ notes|raw }}</div>
            </section>
        {% endif %}
    </div>
{% endblock %}
