APP_NAME=NeoPHP
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=b120b00afaed2b22cfcef31913f9b0d5ae0d4d13d7c8d0147f7ed5bd3508a082

# Base URL used for absolute URLs outside of an HTTP request (console commands, emails sent from the console)
APP_URL=http://127.0.0.1:8000

# DATABASE_URL="mysql://user:password@127.0.0.1:3306/app?charset=utf8mb4"
# DATABASE_URL="postgresql://user:password@127.0.0.1:5432/app?charset=utf8"
DATABASE_URL="sqlite:///%kernel.root_path%/var/data.db"

# MAILER_DSN="smtp://user:password@smtp.example.com:587"
# MAILER_DSN="file://default"   (writes the emails in var/mails/)
MAILER_DSN="null://null"
# Redirects every email to these addresses (comma separated), e.g. in .env.local
MAILER_RECIPIENTS=

FRAMEWORK_REPOSITORY=https://github.com/NeoPHP-Framework/neophp.git

###> http ###
# Reverse proxies (Nginx, load balancer, Cloudflare...) whose X-Forwarded-* headers are trusted: comma separated IPs / CIDR.
# Empty = the application is reached directly. e.g. TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=
# Accepted host names (comma separated); empty = any host (set it in production). e.g. TRUSTED_HOSTS=example.com,*.example.com
TRUSTED_HOSTS=
###> neo_ai ###
# NeoAI development assistant (active only when APP_DEBUG=1), see config/packages/neo_ai.yaml
# Provider of the "default" connection: ollama, openai, anthropic, gemini, mistral, groq, openrouter, lmstudio, vllm, openai_compatible
# Examples (in .env.local):
#   Gemini (free tier):  NEO_AI_PROVIDER=gemini     NEO_AI_MODEL=gemini-3.8-flash  NEO_AI_API_KEY=${GEMINI_API_KEY}
#   OpenAI:              NEO_AI_PROVIDER=openai     NEO_AI_MODEL=gpt-5.4-mini      NEO_AI_API_KEY=${OPENAI_API_KEY}
#   Anthropic:           NEO_AI_PROVIDER=anthropic  NEO_AI_MODEL=claude-sonnet-5   NEO_AI_API_KEY=${ANTHROPIC_API_KEY}
#   Ollama (local):      NEO_AI_PROVIDER=ollama     NEO_AI_MODEL=qwen2.5-coder:7b  (no key; qwen2.5-coder:3b on CPU)
NEO_AI_PROVIDER=ollama
NEO_AI_MODEL=qwen2.5-coder:7b
# Key and base URL of the "default" connection (empty = none / provider default)
NEO_AI_API_KEY=
NEO_AI_BASE_URL=
# API keys of the named connections: put the real values in .env.local, never in .env
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OLLAMA_URL=http://localhost:11434
