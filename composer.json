{
    "name": "neophp/site",
    "description": "The website of the NeoPHP framework.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "neophp",
        "website",
        "documentation"
    ],
    "require": {
        "php": ">=8.2",
        "neophp-package/neo-admin": "^1.0",
        "neophp/framework": "^2.0",
        "twig/twig": "^3.30"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "neo:install": "@php vendor/bin/neo install",
        "post-create-project-cmd": "@neo:install"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
